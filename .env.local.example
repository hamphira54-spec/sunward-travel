# ─────────────────────────────────────────────────────────────────
# Sunward Travel — Environment Variables
#
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────────

# ── Travelpayouts API ─────────────────────────────────────────────
# Get your token from: Travelpayouts Dashboard → API → Access Token
# Without this, the site shows sample/mock flight results.
TRAVELPAYOUTS_API_TOKEN=your_token_here

# ── Site URL ──────────────────────────────────────────────────────
# Used for sitemap, Open Graph, and canonical URLs.
# In production set this to your actual domain.
NEXT_PUBLIC_SITE_URL=https://sunwardtravel.com
