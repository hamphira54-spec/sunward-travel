# ─────────────────────────────────────────────────────────────────────────────
# Sunward Travel - Environment Variables
#
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Travelpayouts API ──────────────────────────────────────────────────────
# Get your token from: Travelpayouts Dashboard → API → Access Token
# Without this, the site shows sample/mock flight results.
TRAVELPAYOUTS_API_TOKEN=your_token_here

# ── Site URL ───────────────────────────────────────────────────────────────
# Used for sitemap, Open Graph, and canonical URLs.
# In production set this to your actual domain.
NEXT_PUBLIC_SITE_URL=https://sunwardtravel.com

# ── PostgreSQL Database (Supabase) ─────────────────────────────────────────
# These values come from your Supabase project:
#   Project Settings → Database → Connection string
#
# DATABASE_URL  = Transaction pooler URL (use for runtime/app queries)
# DIRECT_URL    = Direct connection URL (use for prisma migrate deploy)
#
# Format (Supabase):
#   DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=your_supabase_pooled_connection_url
DIRECT_URL=your_supabase_direct_connection_url

# ── Content Source ─────────────────────────────────────────────────────────
# Controls which data adapter is used.
# Set to 'static' during development and parity testing.
# Switch to 'database' ONLY after full Phase K certification.
CONTENT_SOURCE=static
